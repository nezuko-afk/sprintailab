{
  "name": "sprintailab-governance-proxy",
  "version": "0.1.0",
  "private": true,
  "description": "Governance proxy that sits between an AI agent and REA (rea mcp)",
  "license": "MIT",
  "author": "Pritam Patil",
  "homepage": "https://github.com/nezuko-afk/sprintailab#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nezuko-afk/sprintailab.git"
  },
  "bugs": {
    "url": "https://github.com/nezuko-afk/sprintailab/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
